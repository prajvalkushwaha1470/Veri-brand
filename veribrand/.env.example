# Copy to .env (loaded automatically). Never commit .env.
DEMO_MODE=0                 # set to 1 only for a local/demo showcase; seeded accounts use password Demo@12345
EXPOSE_DEV_OTP=0            # keep 0 outside isolated local testing
DATA_DIR=./data
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME  # optional PostgreSQL runtime
# ADMIN_EMAIL=you@example.com     # designated initial admin; required in production
# REVIEWER_INVITE=change-me       # signup invite code that grants Reviewer
# ADMIN_INVITE=change-me-too      # signup invite code that grants Admin
# RATE_LIMIT=30                   # requests/min per IP per auth route
# CORS_ORIGINS=https://your-frontend.example   # only if the frontend is hosted elsewhere
# --- optional grounded AI pass (retrieve -> LLM -> verify). Off when no key is set ---
# Choose auto, gemini, or openai. auto prefers Gemini when GEMINI_API_KEY is set.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Or use OpenAI-compatible API:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# --- required for production email verification and password reset ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com
# --- P1 Gemini OCR, vision and embedding retrieval ---
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# --- P1 optional Google/GitHub OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/github/callback
# --- P1 optional Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=

# Free plan review quota (active Team subscription bypasses this limit)
FREE_MONTHLY_REVIEW_LIMIT=25
